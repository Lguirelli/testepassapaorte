{
  "name": "Passaporte Serra Negra Validation",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "Passaporte validation app",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": {
    "DB_MODE": "pglite",
    "ALLOW_DEMO": "true"
  }
}
