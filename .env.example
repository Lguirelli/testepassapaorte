# Banco. PGlite é somente desenvolvimento/demo; produção exige PostgreSQL via DATABASE_URL.
DB_MODE=pglite
PGLITE_PATH=.data/passaporte-local
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/passaporte
ENABLE_POSTGIS=false

# Origem pública usada em metadata, canonical, sitemap e social URLs.
# Em produção, esta variável é obrigatória e deve usar HTTPS.
NEXT_PUBLIC_SITE_URL=http://localhost:4173

# Canal comercial opcional. Quando configurado, deve usar HTTPS público.
# NEXT_PUBLIC_PARTNER_CONTACT_URL=https://example.com/contato

# Segredos distintos. Gere valores aleatórios independentes com 32+ caracteres.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Pepper independente para pseudonimização de identidades. Deve ser diferente de SESSION_SECRET em produção.
IDENTITY_PEPPER=replace-with-a-different-32-char-random-value
IDENTITY_PEPPER=replace-with-a-different-32-plus-random-value

# Credenciais do adaptador local. Use somente em desenvolvimento/validação controlada.
# Contas @passaporte.local e senhas de demonstração são recusadas em NODE_ENV=production.
TOURIST_EMAIL=turista@passaporte.local
TOURIST_PASSWORD=change-me-tourist
PARTNER_EMAIL=parceiro@passaporte.local
PARTNER_PASSWORD=change-me-partner
PARTNER_ID=partner-cafe-neblina
ADMIN_EMAIL=admin@passaporte.local
ADMIN_PASSWORD=change-me-admin

# Somente para conveniência local quando as credenciais acima forem omitidas.
# Nunca habilitar em produção.
ALLOW_INSECURE_LOCAL_AUTH=false

# Privacidade / analytics. Limiar agregado nunca é aceito abaixo de 3 no runtime.
QR_DEDUPE_MINUTES=30
TERRITORIAL_FLOW_MIN_COUNT=3
ANALYTICS_COOKIE_DAYS=180
ANALYTICS_RETENTION_DAYS=180
CONSENT_RETENTION_DAYS=730
AUTH_SESSION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=730
