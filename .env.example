# Validation mode. Local file persistence works without external credentials.
NODE_ENV=development
PERSISTENCE_MODE=local
LOCAL_STORE_PATH=.data/validation-store.json
DEMO_MODE=true
AUTH_MODE=mock
MAPS_MODE=mock
ROUTES_MODE=mock
WEATHER_MODE=mock
ANALYTICS_MODE=local

# Set these to use PostgreSQL/PostGIS instead of the local validation store.
DATABASE_URL=postgres://passaporte:passaporte@localhost:5432/passaporte

# Optional when Playwright must use an already installed Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
